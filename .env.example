PORT=3000
DATABASE_URL=postgresql://fitnutri:fitnutri_local@127.0.0.1:5432/fitnutri

# Optional override. Defaults to false in production and true otherwise.
# SWAGGER_ENABLED=true

# pnpm env:setup replaces this placeholder with a unique local signing key.
AUTH_JWT_SECRET=generate-on-local-setup
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Local video server (docker compose --profile video up -d livekit).
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=fitnutri-local
LIVEKIT_API_SECRET=generate-on-local-setup
