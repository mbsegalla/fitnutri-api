generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String               @db.VarChar(120)
  email             String               @unique @db.VarChar(254)
  profile           ProfessionalProfile?
  clientContracts   Contract[]           @relation("Client")
  providerContracts Contract[]           @relation("Provider")
  passwordHash      String
}

enum Modality {
  NUTRITION
  PERSONAL_TRAINING
}

enum CareFormat {
  ONLINE
  IN_PERSON
}

model ProfessionalProfile {
  accountId   String       @id @db.Uuid
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  draft       Json
  published   Boolean      @default(false)
  slug        String?      @unique
  displayName String?
  biography   String?
  photoUrl    String?
  specialties String[]
  modalities  Modality[]
  formats     CareFormat[]
  city        String?
  state       String?
  offers      Offer[]
}

model Offer {
  contracts      Contract[]
  id             String              @id @default(uuid()) @db.Uuid
  professionalId String              @db.Uuid
  profile        ProfessionalProfile @relation(fields: [professionalId], references: [accountId], onDelete: Cascade)
  title          String
  description    String
  modality       Modality
  priceMinor     Int
  currency       String              @db.Char(3)
  durationDays   Int
  included       String[]

  @@index([professionalId])
}

enum ContractStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELED
  ENDED
}

enum PaymentState {
  FREE
  UNPAID
  PAID
}

model Contract {
  plans          PlanVersion[]
  intake         Intake?
  assessments    Assessment[]
  documents      CareDocument[]
  id             String         @id @default(uuid()) @db.Uuid
  clientId       String         @db.Uuid
  client         Account        @relation("Client", fields: [clientId], references: [id], onDelete: Cascade)
  professionalId String         @db.Uuid
  professional   Account        @relation("Provider", fields: [professionalId], references: [id], onDelete: Cascade)
  offerId        String         @db.Uuid
  offer          Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  requestKey     String         @db.Uuid
  modality       Modality
  terms          Json
  status         ContractStatus @default(REQUESTED)
  payment        PaymentState
  active         Boolean        @default(false)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime       @default(now())

  @@unique([clientId, requestKey])
  @@index([professionalId, status])
}

model Intake {
  contractId String    @id @db.Uuid
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  answers    Json
  reviewedAt DateTime?
  updatedAt  DateTime  @updatedAt
}

model Assessment {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  authorId   String   @db.Uuid
  assessedAt DateTime
  measures   Json
  notes      String

  @@index([contractId, assessedAt])
}

model CareDocument {
  id                String    @id @default(uuid()) @db.Uuid
  contractId        String    @db.Uuid
  contract          Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind              String
  filename          String
  contentType       String
  content           Bytes
  authorId          String    @db.Uuid
  createdAt         DateTime  @default(now())
  analysisDraft     String?
  publishedAnalysis String?
  publishedAt       DateTime?

  @@index([contractId, createdAt])
}

model PlanVersion {
  id          String    @id @default(uuid()) @db.Uuid
  contractId  String    @db.Uuid
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version     Int
  content     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  meals       MealLog[]

  @@unique([contractId, version])
  @@index([contractId, publishedAt])
}

model MealLog {
  id        String      @id @default(uuid()) @db.Uuid
  planId    String      @db.Uuid
  plan      PlanVersion @relation(fields: [planId], references: [id], onDelete: Cascade)
  day       String      @db.Char(10)
  mealIndex Int
  status    String
  comment   String?

  @@unique([planId, day, mealIndex])
}
