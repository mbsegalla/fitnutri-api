generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  slots             AvailabilitySlot[]
  notifications     Notification[]
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String               @db.VarChar(120)
  email             String               @unique @db.VarChar(254)
  profile           ProfessionalProfile?
  clientContracts   Contract[]           @relation("Client")
  providerContracts Contract[]           @relation("Provider")
  passwordHash      String
}

enum Modality {
  NUTRITION
  PERSONAL_TRAINING
}

enum CareFormat {
  ONLINE
  IN_PERSON
}

model ProfessionalProfile {
  accountId   String       @id @db.Uuid
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  draft       Json
  published   Boolean      @default(false)
  slug        String?      @unique
  displayName String?
  biography   String?
  photoUrl    String?
  specialties String[]
  modalities  Modality[]
  formats     CareFormat[]
  city        String?
  state       String?
  offers      Offer[]
}

model Offer {
  contracts      Contract[]
  id             String              @id @default(uuid()) @db.Uuid
  professionalId String              @db.Uuid
  profile        ProfessionalProfile @relation(fields: [professionalId], references: [accountId], onDelete: Cascade)
  title          String
  description    String
  modality       Modality
  priceMinor     Int
  currency       String              @db.Char(3)
  durationDays   Int
  included       String[]

  @@index([professionalId])
}

enum ContractStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELED
  ENDED
}

enum PaymentState {
  FREE
  UNPAID
  PAID
}

model Contract {
  appointments   Appointment[]
  messages       Message[]
  checkIns       CheckIn[]
  plans          PlanVersion[]
  intake         Intake?
  assessments    Assessment[]
  documents      CareDocument[]
  id             String         @id @default(uuid()) @db.Uuid
  clientId       String         @db.Uuid
  client         Account        @relation("Client", fields: [clientId], references: [id], onDelete: Cascade)
  professionalId String         @db.Uuid
  professional   Account        @relation("Provider", fields: [professionalId], references: [id], onDelete: Cascade)
  offerId        String         @db.Uuid
  offer          Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  requestKey     String         @db.Uuid
  modality       Modality
  terms          Json
  status         ContractStatus @default(REQUESTED)
  payment        PaymentState
  active         Boolean        @default(false)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime       @default(now())

  @@unique([clientId, requestKey])
  @@index([professionalId, status])
}

model Intake {
  contractId String    @id @db.Uuid
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  answers    Json
  reviewedAt DateTime?
  updatedAt  DateTime  @updatedAt
}

model Assessment {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  authorId   String   @db.Uuid
  assessedAt DateTime
  measures   Json
  notes      String

  @@index([contractId, assessedAt])
}

model CareDocument {
  id                String    @id @default(uuid()) @db.Uuid
  contractId        String    @db.Uuid
  contract          Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind              String
  filename          String
  contentType       String
  content           Bytes
  authorId          String    @db.Uuid
  createdAt         DateTime  @default(now())
  analysisDraft     String?
  publishedAnalysis String?
  publishedAt       DateTime?

  @@index([contractId, createdAt])
}

model PlanVersion {
  sessions    WorkoutSession[]
  id          String           @id @default(uuid()) @db.Uuid
  contractId  String           @db.Uuid
  contract    Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version     Int
  content     Json
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  meals       MealLog[]

  @@unique([contractId, version])
  @@index([contractId, publishedAt])
}

model MealLog {
  id        String      @id @default(uuid()) @db.Uuid
  planId    String      @db.Uuid
  plan      PlanVersion @relation(fields: [planId], references: [id], onDelete: Cascade)
  day       String      @db.Char(10)
  mealIndex Int
  status    String
  comment   String?

  @@unique([planId, day, mealIndex])
}

model WorkoutSession {
  id           String              @id @default(uuid()) @db.Uuid
  planId       String              @db.Uuid
  plan         PlanVersion         @relation(fields: [planId], references: [id], onDelete: Cascade)
  day          String              @db.Char(10)
  workoutIndex Int
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?
  exercises    ExerciseExecution[]
  sets         SetExecution[]

  @@unique([planId, day, workoutIndex])
}

model ExerciseExecution {
  sessionId     String         @db.Uuid
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseIndex Int
  skipped       Boolean
  note          String?

  @@id([sessionId, exerciseIndex])
}

model SetExecution {
  sessionId     String         @db.Uuid
  session       WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseIndex Int
  setIndex      Int
  reps          Int?
  seconds       Int?
  loadKg        Float?

  @@id([sessionId, exerciseIndex, setIndex])
}

model CheckIn {
  id         String    @id @default(uuid()) @db.Uuid
  contractId String    @db.Uuid
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  weekStart  String    @db.Char(10)
  adherence  Int
  difficulty String?
  comments   String?
  createdAt  DateTime  @default(now())
  reply      String?
  repliedAt  DateTime?

  @@unique([contractId, weekStart])
}

model Message {
  id         String    @id @default(uuid()) @db.Uuid
  contractId String    @db.Uuid
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  senderId   String    @db.Uuid
  requestKey String    @db.Uuid
  body       String
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@unique([contractId, senderId, requestKey])
  @@index([contractId, createdAt, id])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  eventKey  String
  kind      String
  href      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@unique([accountId, eventKey])
  @@index([accountId, createdAt, id])
}

model AvailabilitySlot {
  id             String        @id @default(uuid()) @db.Uuid
  professionalId String        @db.Uuid
  professional   Account       @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startsAt       DateTime      @db.Timestamptz(3)
  endsAt         DateTime      @db.Timestamptz(3)
  timeZone       String
  format         CareFormat
  appointments   Appointment[]

  @@unique([professionalId, startsAt])
}

model Appointment {
  id            String           @id @default(uuid()) @db.Uuid
  contractId    String           @db.Uuid
  contract      Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  slotId        String           @db.Uuid
  slot          AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  initialSlotId String           @db.Uuid
  requestKey    String           @db.Uuid
  revision      Int              @default(1)
  canceledAt    DateTime?

  @@unique([contractId, requestKey])
  @@index([slotId, canceledAt])
}
